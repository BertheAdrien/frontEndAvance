# Copier en .env et renseigner les valeurs (le fichier .env est ignoré par Git).

# Secret servant à dériver les flags (HMAC). Absent : un secret aléatoire est tiré
# à chaque démarrage, et les flags changent à chaque redémarrage.
# Générer : node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FLAG_SECRET=

# Chemin du fichier SQLite (défaut : ./breach-academy.db).
DATABASE_PATH=

# Mode vulnérable des niveaux (démo pédagogique) : "true" pour l'autoriser.
# Absent ou toute autre valeur : seul le mode sécurisé existe.
BREACH_VULNERABLE_MODE=
